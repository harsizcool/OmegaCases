-- Generated by the OmegaCases setup program.
--
-- Mounted into /docker-entrypoint-initdb.d, so PostgreSQL runs it once, while
-- the database is being created, as the bootstrap superuser. That is the only
-- moment when these roles can reliably be given a password: afterwards the
-- supabase/postgres image runs as a non-superuser and marks them reserved, so
-- ALTER ROLE is refused.
--
-- The data services — PostgREST, Storage, Realtime — log in with the password
-- set here, over TCP, where pg_hba demands it.

DO $omega_init$
DECLARE
  pw TEXT := {{.PasswordLiteral}};
BEGIN
  -- Request roles. The image already has these; a plain postgres image does not.
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'anon') THEN
    CREATE ROLE anon NOLOGIN NOINHERIT;
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'authenticated') THEN
    CREATE ROLE authenticated NOLOGIN NOINHERIT;
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'service_role') THEN
    CREATE ROLE service_role NOLOGIN NOINHERIT BYPASSRLS;
  END IF;

  -- PostgREST's login role. It owns nothing and inherits nothing: every request
  -- switches it into one of the three above, based on the JWT.
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'authenticator') THEN
    EXECUTE format('CREATE ROLE authenticator LOGIN NOINHERIT PASSWORD %L', pw);
  ELSE
    EXECUTE format('ALTER ROLE authenticator WITH LOGIN PASSWORD %L', pw);
  END IF;
  EXECUTE 'GRANT anon, authenticated, service_role TO authenticator';

  -- Storage keeps its own tables and migrates them itself.
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'supabase_storage_admin') THEN
    EXECUTE format('CREATE ROLE supabase_storage_admin LOGIN CREATEROLE PASSWORD %L', pw);
  ELSE
    EXECUTE format('ALTER ROLE supabase_storage_admin WITH LOGIN PASSWORD %L', pw);
  END IF;

  -- Realtime connects as this one.
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'supabase_admin') THEN
    EXECUTE format(
      'CREATE ROLE supabase_admin LOGIN SUPERUSER CREATEDB CREATEROLE REPLICATION BYPASSRLS PASSWORD %L', pw);
  ELSE
    EXECUTE format('ALTER ROLE supabase_admin WITH LOGIN PASSWORD %L', pw);
  END IF;
END
$omega_init$;

CREATE SCHEMA IF NOT EXISTS storage AUTHORIZATION supabase_storage_admin;
GRANT USAGE ON SCHEMA storage TO anon, authenticated, service_role;
CREATE SCHEMA IF NOT EXISTS _realtime AUTHORIZATION supabase_admin;
CREATE EXTENSION IF NOT EXISTS pgcrypto;

-- Realtime reads changes out of the write-ahead log, which needs logical
-- replication. Set here it applies from the first start, with no restart.
ALTER SYSTEM SET wal_level = 'logical';
ALTER SYSTEM SET max_replication_slots = 10;
ALTER SYSTEM SET max_wal_senders = 10;
