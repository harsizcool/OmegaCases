-- Generated by the OmegaCases setup program for a test copy of the site.
--
-- A brand new site has no items in it, which means cases cannot be opened and
-- most of the site has nothing to show. This adds a small pool to play with, and
-- gives the admin account some cases and a balance to spend, so everything is
-- explorable the moment setup finishes.
--
-- The pictures are drawn inline rather than linked, so the test copy works with
-- no internet connection and nothing to host. Colours use rgb() because a "#"
-- inside an image address would be read as a link fragment.

-- Only ever seeds an empty pool: this must never add duplicates to a site that
-- already has items, however many times setup is re-run.
DO $seed$
DECLARE
  existing INTEGER;
BEGIN
  SELECT count(*) INTO existing FROM public.items;
  IF existing > 0 THEN
    RAISE NOTICE 'the item pool already has % items, leaving it alone', existing;
    RETURN;
  END IF;

  INSERT INTO public.items (name, image_url, rarity, likelihood, market_price, rap, limited_time)
  VALUES
    ('Test Sticker',   {{.Common}},    'Common',    30,    0.01,   0.01,   FALSE),
    ('Test Keycap',    {{.Common}},    'Common',    25,    0.02,   0.02,   FALSE),
    ('Test Coin',      {{.Common}},    'Common',    20,    0.03,   0.03,   FALSE),
    ('Test Badge',     {{.Uncommon}},  'Uncommon',  10,    0.06,   0.06,   FALSE),
    ('Test Charm',     {{.Uncommon}},  'Uncommon',   8,    0.09,   0.09,   FALSE),
    ('Test Relic',     {{.Rare}},      'Rare',       4,    0.20,   0.20,   FALSE),
    ('Test Crown',     {{.Rare}},      'Rare',       2,    0.35,   0.35,   FALSE),
    ('Test Dragon',    {{.Legendary}}, 'Legendary',  0.9,  1.50,   1.50,   FALSE),
    ('Test Omega',     {{.Omega}},     'Omega',      0.1,  500.00, 500.00, TRUE);

  RAISE NOTICE 'added 9 test items';
END
$seed$;

-- Something to spend, so cases can be opened straight away.
DO $topup$
DECLARE
  target TEXT := {{.AdminLiteral}};
BEGIN
  IF target IS NULL OR target = '' THEN
    RETURN;
  END IF;

  UPDATE public.users
     SET balance         = GREATEST(balance, 100.00),
         cases_remaining = GREATEST(cases_remaining, 250),
         plus            = TRUE
   WHERE username = target;

  IF FOUND THEN
    RAISE NOTICE 'gave % a balance, 250 cases and Plus to test with', target;
  END IF;
END
$topup$;
