# Generated by the OmegaCases setup program.
{
{{- if .TLS }}
	email {$ACME_EMAIL}
{{- else }}
	auto_https off
{{- end }}
	admin off
}

# The routing is defined once and used by both listeners below.
(omegacases) {
	encode zstd gzip

{{- if .Local }}
	# The Supabase API paths are served on the same origin as the site. The
	# browser client is configured with this origin as its Supabase URL, so
	# these three prefixes are what it calls.
	handle /rest/v1/* {
		uri strip_prefix /rest/v1
		reverse_proxy rest:3000
	}

	handle /storage/v1/* {
		uri strip_prefix /storage/v1
		reverse_proxy storage:5000
	}

	handle /realtime/v1/* {
		uri strip_prefix /realtime/v1
		rewrite * /socket{uri}
		reverse_proxy realtime:4000
	}

	# Nothing in the app calls /auth/v1: accounts live in the users table and
	# are checked in the API routes, so there is no auth service to proxy to.
	handle /auth/v1/* {
		respond "auth service is not part of this deployment" 404
	}
{{- end }}

	handle {
		reverse_proxy web:3000
	}
}

# What the public reaches.
{$SITE_ADDRESS} {
	import omegacases
}

# The same routes on a port that is never published to the host. The site's own
# server-side code calls this, because the public address resolves back to the
# site itself from inside the container network.
:8080 {
	import omegacases
}
