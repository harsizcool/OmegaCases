-- Generated by the OmegaCases setup program, applied before the project's own
-- migrations.
--
-- The supabase/postgres image already provisions every role, schema and setting
-- below, using the same POSTGRES_PASSWORD this stack was generated with. This
-- file exists for the case where it has not: a plain postgres image, or a
-- half-configured database. So it creates only what is missing and treats a
-- refusal as information rather than failure.
--
-- Refusals are expected, not a problem: that image marks these roles reserved
-- through the supautils extension and runs as a non-superuser postgres, so
-- altering them is denied. They are already correct, so there is nothing to do.

-- Runs a statement and carries on if the server refuses it, saying which one it
-- skipped and why. Created in pg_temp so it needs no privileges and disappears
-- with the connection.
CREATE OR REPLACE FUNCTION pg_temp.omega_try(stmt TEXT) RETURNS BOOLEAN AS $omega_fn$
BEGIN
  EXECUTE stmt;
  RETURN TRUE;
EXCEPTION WHEN OTHERS THEN
  RAISE NOTICE 'skipped: % (%)', stmt, SQLERRM;
  RETURN FALSE;
END
$omega_fn$ LANGUAGE plpgsql;

DO $omega_report$
BEGIN
  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = current_user AND rolsuper) THEN
    RAISE NOTICE 'connected as % (superuser)', current_user;
  ELSE
    RAISE NOTICE 'connected as % (not a superuser: pre-provisioned roles will be left alone)', current_user;
  END IF;
END
$omega_report$;

-- ─────────────────────────────────────────────────────────────────────────────
-- Roles
--
-- anon, authenticated and service_role are what a request's JWT selects between.
-- authenticator is the login role PostgREST connects as; it owns nothing and
-- inherits nothing, and only switches into one of the other three.
-- ─────────────────────────────────────────────────────────────────────────────
DO $omega_roles$
DECLARE
  pw       TEXT := {{.PasswordLiteral}};
  is_super BOOLEAN := EXISTS (SELECT 1 FROM pg_roles WHERE rolname = current_user AND rolsuper);

  -- Login roles: name, the options to create them with.
  logins TEXT[][] := ARRAY[
    ARRAY['authenticator',          'LOGIN NOINHERIT'],
    ARRAY['supabase_admin',         'LOGIN SUPERUSER CREATEDB CREATEROLE REPLICATION BYPASSRLS'],
    ARRAY['supabase_storage_admin', 'LOGIN CREATEROLE']
  ];
  entry TEXT[];
BEGIN
  -- Group roles, which never log in.
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'anon') THEN
    PERFORM pg_temp.omega_try('CREATE ROLE anon NOLOGIN NOINHERIT');
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'authenticated') THEN
    PERFORM pg_temp.omega_try('CREATE ROLE authenticated NOLOGIN NOINHERIT');
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'service_role') THEN
    PERFORM pg_temp.omega_try('CREATE ROLE service_role NOLOGIN NOINHERIT BYPASSRLS');
  END IF;

  FOREACH entry SLICE 1 IN ARRAY logins LOOP
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = entry[1]) THEN
      PERFORM pg_temp.omega_try(
        format('CREATE ROLE %I %s PASSWORD %L', entry[1], entry[2], pw));
    ELSE
      -- The password has to be set even when the role already exists: the
      -- image creates these roles but does not give them this stack's password,
      -- and the data services log in with it. Attempted whether or not this
      -- connection is a superuser, because the installer verifies the result
      -- afterwards and repairs it if this was refused.
      IF NOT pg_temp.omega_try(format('ALTER ROLE %I LOGIN PASSWORD %L', entry[1], pw))
         AND NOT is_super THEN
        RAISE NOTICE 'OMEGA_ROLE_PASSWORD_REFUSED: % (needs a superuser)', entry[1];
      END IF;
    END IF;
  END LOOP;
END
$omega_roles$;

-- Membership, so authenticator can become each of the request roles. Already
-- granted on the Supabase image, and refused there because authenticator is
-- reserved.
SELECT pg_temp.omega_try('GRANT anon, authenticated, service_role TO authenticator');

-- ─────────────────────────────────────────────────────────────────────────────
-- Schemas that the storage and realtime services keep their own tables in.
-- Both run their own migrations on connect; they just need somewhere to put
-- them, and the Supabase image has already made both.
-- ─────────────────────────────────────────────────────────────────────────────
SELECT pg_temp.omega_try('CREATE SCHEMA IF NOT EXISTS storage AUTHORIZATION supabase_storage_admin');
SELECT pg_temp.omega_try('GRANT ALL ON SCHEMA storage TO supabase_storage_admin');
SELECT pg_temp.omega_try('GRANT USAGE ON SCHEMA storage TO anon, authenticated, service_role');
SELECT pg_temp.omega_try('ALTER ROLE supabase_storage_admin SET search_path TO storage, public');
SELECT pg_temp.omega_try('CREATE SCHEMA IF NOT EXISTS _realtime AUTHORIZATION supabase_admin');

-- gen_random_uuid() is built in from PostgreSQL 13 on, but parts of the
-- project's schema also use pgcrypto's digest functions.
SELECT pg_temp.omega_try('CREATE EXTENSION IF NOT EXISTS pgcrypto');

-- ─────────────────────────────────────────────────────────────────────────────
-- Logical replication is what Realtime reads changes from. The Supabase image
-- already sets this; on a plain image the change needs a restart, which setup
-- performs when this reports that it made one.
-- ─────────────────────────────────────────────────────────────────────────────
DO $omega_wal$
BEGIN
  IF current_setting('wal_level', true) IS DISTINCT FROM 'logical' THEN
    IF pg_temp.omega_try('ALTER SYSTEM SET wal_level = ''logical''') THEN
      PERFORM pg_temp.omega_try('ALTER SYSTEM SET max_replication_slots = 10');
      PERFORM pg_temp.omega_try('ALTER SYSTEM SET max_wal_senders = 10');
      RAISE NOTICE 'OMEGA_RESTART_REQUIRED: wal_level was changed to logical';
    ELSE
      RAISE NOTICE 'wal_level is % and could not be changed; live updates will not work',
        current_setting('wal_level', true);
    END IF;
  END IF;
END
$omega_wal$;
