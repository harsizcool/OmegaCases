@echo off
REM Starts OmegaCases. Generated by the setup program.
cd /d "%~dp0"
echo Starting OmegaCases...
docker compose up -d
if errorlevel 1 (
  echo.
  echo Could not start. Is Docker Desktop running?
  pause
  exit /b 1
)
echo.
echo OmegaCases is starting up. In about a minute it will be at:
echo    {{.PublicURL}}
echo.
pause
