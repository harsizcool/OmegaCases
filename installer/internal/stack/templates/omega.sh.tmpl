#!/bin/sh
# Controls OmegaCases. Generated by the setup program.
set -e
cd "$(dirname "$0")"

case "${1:-}" in
  start)
    docker compose up -d
    echo "OmegaCases is starting. In about a minute it will be at {{.PublicURL}}"
    ;;
  stop)
    docker compose down
    echo "Stopped. Your data is kept — run './omega.sh start' to bring it back."
    ;;
  restart)
    docker compose restart
    ;;
  status)
    docker compose ps
    ;;
  logs)
    docker compose logs -f --tail=100 "${2:-}"
    ;;
  update)
    # Rebuilds the site from the current source and restarts just that service.
    docker compose up -d --build web
    ;;
  *)
    echo "Usage: ./omega.sh {start|stop|restart|status|logs [service]|update}"
    exit 1
    ;;
esac
